{
  "name": "mysite",
  "type": "module",
  "version": "1.0.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "prepare": "husky",
    "type-check": "astro check",
    "test": "playwright test --grep-invert @vrt",
    "test:vrt": "playwright test --grep @vrt",
    "test:vrt:update": "playwright test --grep @vrt --update-snapshots"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.145",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "astro-icon": "1.2.0",
    "daisyui": "5.7.50",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@actions/github-script": "github:actions/github-script#v9.0.0",
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/parser": "8.71.2",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
